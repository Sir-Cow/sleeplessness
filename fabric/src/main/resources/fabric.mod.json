{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "contact": {
        "homepage": "https://teampreserved.com/sleeplessness",
        "sources": "https://github.com/Sir-Cow/sleeplessness",
        "issues": "https://github.com/Sir-Cow/sleeplessness/issues"
    },
    "license": "${license}",
    "icon": "icon.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "sircow.sleeplessness.FabricSleeplessness"
        ]
    },
    "mixins": [
        "${mod_id}.mixins.json",
        "${mod_id}.fabric.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-api": "*",
        "minecraft": "~${minecraft_version}",
        "java": ">=${java_version}"
    },
    "custom": {
        "modmenu": {
            "links": {
                "modmenu.website": "https://teampreserved.com/sleeplessness",
                "modmenu.modrinth": "https://modrinth.com/project/iFcpR7Js",
                "modmenu.curseforge": "https://curseforge.com/minecraft/mc-mods/sleeplessness"
            },
            "update_checker": true
        }
    }
}